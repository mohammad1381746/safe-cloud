# =============================================================================
# Nextcloud Upload Scanner - Scanner Server configuration
# Copy to .env (repo root, next to docker-compose.yml) and fill in real
# values. Never commit the real .env file. Shared by the `api` and
# `worker` services (and, for bare-metal/systemd, both processes read it
# too - see systemd/scanner-api.service + scanner-worker.service).
# =============================================================================

# Bearer token(s) accepted by the API. Comma-separated to support multiple
# Nextcloud hosts / clients, each with its own token.
SCANNER_API_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# JSON object: one entry per Nextcloud server. The KEY is what the Bash
# client sends as `hostname` AND the exact Ansible inventory hostname in
# ansible/inventory.ini's [nextcloud] group (the two must match exactly -
# see ansible/inventory.ini's comments). `ansible_host` here is
# informational only (shown in the panel); the real SSH connection
# details live solely in inventory.ini. `allowed_root` is the ONLY
# directory tree this host is ever allowed to have files scanned from.
NEXTCLOUD_HOSTS={"nextcloud01":{"ansible_host":"192.168.150.87","allowed_root":"/var/www/nextcloud/data"}}

# --- Database (PostgreSQL - metadata/results only, never file content) ---
POSTGRES_USER=scanner
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=scanner
DATABASE_URL=postgresql://scanner:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/scanner
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- Ansible ---
# Paths below assume the Docker layout (baked into the image at
# /app/ansible - see api/Dockerfile). If deploying bare metal via
# systemd instead, override these to point at
# /opt/nextcloud-upload-scanner/ansible/... instead.
ANSIBLE_SCAN_PLAYBOOK_PATH=/app/ansible/scan_pipeline.yml
ANSIBLE_DELETE_PLAYBOOK_PATH=/app/ansible/delete_infected_source.yml
ANSIBLE_INVENTORY_PATH=/app/ansible/inventory.ini
ANSIBLE_CONFIG_PATH=/app/ansible/ansible.cfg
ANSIBLE_TIMEOUT=120
ANSIBLE_DELETE_TIMEOUT=60
ANSIBLE_RUNS_DIR=/var/lib/nextcloud-scanner/runs

# --- ClamAV / Docker (Scanner Server only - see docker-compose.yml) ---
CLAMAV_TIMEOUT=120
DOCKER_SCAN_IMAGE=nextcloud-scanner-clamav:latest
# GID that actually owns /var/run/docker.sock, so the `worker`
# container's non-root user can use the bind-mounted socket. On a plain
# Linux host: getent group docker | cut -d: -f3
# On Docker Desktop (Windows/Mac), that's unreliable - the daemon runs in
# its own VM - ask it directly instead:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# --- Staging / quarantine on the Scanner Server (never /tmp - see README) ---
STAGING_BASE=/var/lib/upload-scanner/staging
QUARANTINE_BASE=/var/lib/upload-scanner/quarantine
RETAIN_INFECTED_COPY=false
STAGING_MAX_LIFETIME_SECONDS=3600

# --- Limits ---
# 5 GiB default
MAX_FILE_SIZE=5368709120
RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=16384

# --- CORS ---
# Comma-separated origins. Empty = no cross-origin requests permitted.
CORS_ALLOWED_ORIGINS=

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2

# --- Bash client polling defaults (documented here for the panel/README;
# scripts/nextcloud-upload-scanner.sh reads its OWN config file, not this one) ---
CLIENT_POLL_INTERVAL_SECONDS=3
CLIENT_POLL_TIMEOUT_SECONDS=180

# --- Management panel ---
# Random secret used to sign session cookies - generate with e.g.
# `openssl rand -hex 32`. Changing it invalidates all logged-in sessions.
PANEL_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
PANEL_ADMIN_USERNAME=admin
# Generate with: python3 -c "from panel.auth import hash_password; print(hash_password('your-password'))"
# (run inside the api/worker container or a venv with api/ on sys.path)
PANEL_ADMIN_PASSWORD_HASH=CHANGE_ME_RUN_hash_password
# Set to false ONLY for local http:// testing without TLS. Keep true in
# any real deployment - see README "Firewall / HTTPS".
PANEL_SESSION_COOKIE_SECURE=true
PANEL_SESSION_MAX_AGE_SECONDS=28800

# --- Logging ---
LOG_LEVEL=INFO
# "json" (default) - one JSON object per line, for log aggregation /
# machine parsing. "text" - compact, colorized, human-readable lines for
# reading directly via `docker compose logs -f worker` while debugging -
# a failed scan's per-scanner error is shown inline, not just a terse
# summary. LOG_FILE (below) always gets JSON regardless of this setting.
LOG_FORMAT=json
# Leave empty to log to stdout only (recommended under Docker/systemd)
LOG_FILE=
